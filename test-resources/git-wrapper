#!/usr/bin/env bb

(require '[babashka.fs :as fs]
         '[babashka.process :as p])

(def key-path
  (str (fs/file (fs/parent *file*) "id_ed25519_bbin_test_lib_private")))

(def private-repo
  #"bitbucket\.org[:/]radsmith/bbin-test-lib-private")

(def git-config-opts
  (str "core.sshCommand=ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -i '" key-path "'"))

(if (some #(re-find private-repo %) *command-line-args*)
  (do
    (when-not (fs/windows?)
      (fs/set-posix-file-permissions key-path "rw-------"))
    (if (= "clone" (first *command-line-args*))
      (apply p/exec "git" "clone" "-c" git-config-opts (rest *command-line-args*))
      (apply p/exec "git" "-c" git-config-opts *command-line-args*)))
  (apply p/exec "git" *command-line-args*))
