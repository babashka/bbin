{:min-bb-version "1.3.191"
 :paths ["src" "test" "test-resources" "dev"]
 :pods {org.babashka/fswatcher {:version "0.0.7"}}
 :deps {local/deps {:local/root "."}}
 :bbin/bin {bbin {:main-opts ["-f" "bbin"]}}
 :tasks {:requires ([babashka.fs :as fs]
                    [clojure.string :as str])
         :init (defn test-env []
                 (if (fs/windows?)
                   (let [key-path (-> (fs/absolutize "test-resources/id_ed25519_bbin_test_lib_private")
                                      str
                                      (str/replace "\\" "/"))]
                     {"GIT_SSH_COMMAND" (str "ssh -o StrictHostKeyChecking=no"
                                             " -o UserKnownHostsFile=/dev/null"
                                             " -i '" key-path "'")})
                   {"GITLIBS_COMMAND" (str (fs/absolutize "test-resources/git-wrapper"))}))
         bbin {:requires ([babashka.bbin.cli :as bbin])
               :task (apply bbin/-main *command-line-args*)}
         dev {:doc "Starts watcher to auto-build bbin script and an nREPL server"
              :task (shell {:extra-env (test-env)} "bb run -dev")}
         -dev {:extra-deps {ring/ring-core {:mvn/version "1.15.6"}}
               :requires ([babashka.bbin.dev :as dev])
               :task (dev/dev)}
         ci {:doc "Run all CI tasks locally"
             :requires ([taoensso.timbre :as log])
             :task (do
                     (log/info "bb run lint")
                     (run 'lint)
                     (log/info "bb run test")
                     (run 'test))}
         lint (let [classpath (:out (shell {:out :string} "bb clojure -Spath -M:test"))]
                (shell "mkdir -p .clj-kondo")
                (shell
                  "clj-kondo --dependencies --parallel --copy-configs"
                  "--lint" classpath
                  "--skip-lint")
                (apply shell
                  "clj-kondo --parallel --lint src test dev bb.edn deps.edn"
                  *command-line-args*))
         test {:depends [gen-script]
               :task (apply shell {:extra-env (test-env)} "bb run -test" *command-line-args*)}
         -test {:extra-deps {io.github.cognitect-labs/test-runner
                             {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                             ring/ring-core {:mvn/version "1.15.6"}}
                :task cognitect.test-runner/-main}
         gen-script {:doc "Build the bbin script"
                     :extra-deps {org.clojure/tools.namespace
                                  {:mvn/version "1.5.1"}}
                     :requires ([babashka.bbin.gen-script :as gen-script])
                     :task (gen-script/gen-script)}
         render-templates {:requires ([clojure.string :as str]
                                      [clojure.edn :as edn]
                                      [selmer.parser :as p]
                                      [selmer.util :refer [without-escaping]])
                           :task (let [version (some-> (slurp "deps.edn") edn/read-string
                                                       :aliases :neil :project :version)]
                                   (without-escaping
                                     (->> (p/render (slurp "templates/docs/installation.template.md")
                                            {:version version})
                                       (spit "docs/installation.md")))
                                   (without-escaping
                                     (->> (p/render (slurp "templates/README.template.md")
                                                    {:version version})
                                          (spit "README.md"))))}}}
